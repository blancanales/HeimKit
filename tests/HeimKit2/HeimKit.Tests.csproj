<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameManaged>$(ServerPath)\valheim_server_Data\Managed</GameManaged>
    <HeimKitProject Condition="'$(HeimKitProject)' == '' and Exists('..\..\src\HeimKit2\HeimKit.csproj')">..\..\src\HeimKit2\HeimKit.csproj</HeimKitProject>
    <HeimKitProject Condition="'$(HeimKitProject)' == ''">..\..\src\HeimKit\HeimKit.csproj</HeimKitProject>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(ServerPath)\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(HeimKitProject)" />
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(GameManaged)\assembly_valheim.dll</HintPath></Reference>
    <Reference Include="assembly_utils"><HintPath>$(GameManaged)\assembly_utils.dll</HintPath></Reference>
    <Reference Include="SoftReferenceableAssets"><HintPath>$(GameManaged)\SoftReferenceableAssets.dll</HintPath></Reference>
    <Reference Include="Splatform"><HintPath>$(GameManaged)\Splatform.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
